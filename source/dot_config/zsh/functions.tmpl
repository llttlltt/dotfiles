{{- if eq .chezmoi.os "darwin" }}
# find the id of a program
function findappid() {
    local app_list=$(command find /Applications -iname "*.app" -maxdepth 1 -exec basename {} \; | command sed "s/\.app$//")
    app_list+=("Finder")
    local selected_app=$(command printf "%s\n" "${app_list[@]}" | command sort -r | command fzf --query="$(
            IFS=" "
            echo "$*"
    )" -1)
    
    if [ -n "$selected_app" ]; then
        osascript -e "id of app \"$selected_app\""
    fi
}
{{- end }}

# Interactively find and trash node_modules below the current directory.
# Requires: fd, fzf, trash (macOS `trash` CLI), du, awk, sort, and xargs.
function tidynode() {
    local root root_label selected selected_line relative_path candidate_path
    local total_kb total_display reply command_name
    local -a missing selected_lines paths

    if (( $# > 1 )); then
        print -u2 'Usage: tidynode [directory]'
        return 2
    fi

    root_label="${1:-.}"
    root="$root_label"
    if [[ ! -d "$root" ]]; then
        print -u2 "tidynode: not a directory: $root"
        return 2
    fi
    root="${root:A}"

    if [[ "$root" == "$HOME" || "$root" == / ]]; then
        print -u2 "tidynode: '$root_label' resolves to the broad search root: $root"
        read -r "reply?Search everything below this directory, including hidden and ignored folders? [y/N] "
        print
        [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]] || {
            print 'Cancelled. Try again from a project directory or pass its path explicitly.'
            return 0
        }
    fi

    for command_name in fd fzf trash du awk sort xargs; do
        command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
    done
    if (( ${#missing} )); then
        print -u2 "tidynode: missing required commands: ${missing[*]}"
        return 127
    fi

    selected=$(
        cd "$root" || exit 1
        command fd --hidden --type directory --no-ignore --print0 '^node_modules$' --prune \
                --exclude .git \
                --exclude .cache \
                --exclude .local \
                --exclude .pnpm-store \
            | command xargs -0 -P 8 -n 1 du -sh \
            | command sort -t $'\t' -k2,2 \
            | command fzf --multi \
                --height '90%' \
                --layout reverse \
                --border rounded \
                --padding 1 \
                --prompt 'node_modules > ' \
                --pointer '▶' \
                --marker '✓' \
                --info inline-right \
                --header "Root: $root  •  Tab: toggle  •  Ctrl-A: all  •  Ctrl-D: none  •  Enter: continue" \
                --bind 'ctrl-a:select-all,ctrl-d:deselect-all' \
                --preview-window 'right,55%,border-left' \
                --preview 'printf "Contents of %s\n\n" {2..}; ls -la -- {2..}'
    ) || return 0

    [[ -n "$selected" ]] || {
        print 'No folders selected.'
        return 0
    }

    selected_lines=("${(@f)selected}")
    for selected_line in "${selected_lines[@]}"; do
        # `du` separates its size and path with a tab.
        relative_path="${selected_line#*$'\t'}"
        paths+=("${root}/${relative_path#./}")
    done

    total_kb=0
    for candidate_path in "${paths[@]}"; do
        (( total_kb += $(command du -sk "$candidate_path" | command awk '{print $1}') ))
    done

    total_display=$(command awk -v kb="$total_kb" 'BEGIN {
        if (kb >= 1048576) printf "%.1f GB", kb / 1048576
        else printf "%.1f MB", kb / 1024
    }')

    print
    read -r "reply?Trash ${#paths} selected folder(s) and reclaim approximately ${total_display}? [y/N] "
    print
    [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]] || {
        print 'Cancelled. Nothing was trashed.'
        return 0
    }

    for candidate_path in "${paths[@]}"; do
        command trash "$candidate_path" || {
            print -u2 "tidynode: failed to trash: $candidate_path"
            return 1
        }
    done

    print '\n✨ Successfully trashed selected folders!'
    print "💾 Reclaimed approximately ${total_display} of disk space."
}

# Run AI CLIs with secrets resolved from machine-local 1Password references.
function claude() {
    local env_file="$HOME/.config/ai-proxy/claude.env"
    local executable

    executable="$(whence -p claude)" || {
        print -u2 'claude: executable not found'
        return 127
    }
    [[ -r "$env_file" ]] || {
        print -u2 "claude: missing or unreadable environment file: $env_file"
        return 1
    }
    command -v op >/dev/null 2>&1 || {
        print -u2 'claude: 1Password CLI not found'
        return 127
    }

    # Output masking pipes stdout/stderr, which breaks interactive terminal detection.
    command op run --no-masking --env-file="$env_file" -- "$executable" "$@"
}

function codex() {
    local env_file="$HOME/.config/ai-proxy/codex.env"
    local executable

    executable="$(whence -p codex)" || {
        print -u2 'codex: executable not found'
        return 127
    }
    [[ -r "$env_file" ]] || {
        print -u2 "codex: missing or unreadable environment file: $env_file"
        return 1
    }
    command -v op >/dev/null 2>&1 || {
        print -u2 'codex: 1Password CLI not found'
        return 127
    }

    # Output masking pipes stdout/stderr, which breaks interactive terminal detection.
    command op run --no-masking --env-file="$env_file" -- zsh -c '
        set -eu
        : "${CLIPROXY_API_KEY:?CLIPROXY_API_KEY is not set}"
        : "${CLIPROXY_BASE_URL:?CLIPROXY_BASE_URL is not set}"
        exec "$1" \
            -c model_provider=cliproxy \
            -c model_providers.cliproxy.name=cliproxy \
            -c "model_providers.cliproxy.base_url=${CLIPROXY_BASE_URL%/}/v1" \
            -c model_providers.cliproxy.wire_api=responses \
            -c model_providers.cliproxy.env_key=CLIPROXY_API_KEY \
            "${@:2}"
    ' zsh "$executable" "$@"
}
