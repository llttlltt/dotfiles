confirm-close-surface = false

macos-titlebar-style = "tabs"

theme = "poimandres"

font-family = "JetBrainsMono Nerd Font"
font-size = 16
font-feature = -calt
font-feature = -liga
font-feature = -dlig
bold-is-bright = true

adjust-underline-position = 10

background-opacity = 0.9
background-blur-radius = 100

window-padding-x = 10
window-padding-y = 0
window-padding-balance = true

# Keep Option-based symbols (e.g. Option+2), with either Option key.
macos-option-as-alt = false
# Send Alt+J/K explicitly for Neovim's line/selection movement.
keybind = alt+j=esc:j
keybind = alt+k=esc:k
macos-icon = "official"
macos-icon-frame = "aluminum"
macos-icon-ghost-color = "#A6ACCD"
macos-icon-screen-color = "#5DE4C7"

custom-shader = shader-presets/faded_warp.glsl
custom-shader = shader-presets/ripple.glsl
