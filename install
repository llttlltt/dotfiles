#!/bin/sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if ! command -v chezmoi >/dev/null 2>&1; then
    case $(uname -s) in
        Darwin)
            command -v brew >/dev/null 2>&1 || {
                printf '%s\n' 'Install Homebrew from https://brew.sh first.' >&2
                exit 1
            }
            brew install chezmoi
            ;;
        Linux)
            command -v pacman >/dev/null 2>&1 || {
                printf '%s\n' 'Only Omarchy/Arch Linux is currently supported.' >&2
                exit 1
            }
            sudo pacman -S --needed chezmoi
            ;;
        *)
            printf '%s\n' 'Supported targets are macOS and Omarchy/Arch Linux.' >&2
            exit 1
            ;;
    esac
fi

chezmoi init --source "$repo_dir"

if [ "${1:-}" = "--apply" ]; then
    chezmoi --source "$repo_dir" apply --interactive
else
    printf '%s\n' 'Source initialized. Review proposed changes with:'
    printf '  chezmoi --source %s diff\n' "$repo_dir"
    printf '%s\n' 'Then apply interactively with: ./install --apply'
fi
